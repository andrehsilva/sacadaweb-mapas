{
  "name": "sacadaweb-mapas",
  "version": "1.5.0",
  "private": true,
  "description": "Mapas mentais e organogramas com exportação para POP, PNG, SVG, PDF, CSV e Excel",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file=.env --watch server/src/index.js",
    "start": "node server/src/index.js",
    "appwrite:setup": "node --env-file=.env tools/appwrite-setup.mjs",
    "appwrite:user": "node --env-file=.env tools/appwrite-user.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "node-appwrite": "^18.0.0"
  }
}
