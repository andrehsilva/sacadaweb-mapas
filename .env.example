# ============================================================================
# SacadaWeb - Mapas :: modelo das variáveis de ambiente
# Copie para .env (`cp .env.example .env`) e preencha o bloco do Appwrite.
# ============================================================================

# ---------------------------------------------------------------- Appwrite ---
# Endpoint com /v1 no fim. Exemplos:
#   self-hosted na VPS  -> https://appwrite.seudominio.com/v1
#   Appwrite Cloud      -> https://cloud.appwrite.io/v1
APPWRITE_ENDPOINT=

# ID do projeto no Appwrite (Console -> Settings -> Project ID).
APPWRITE_PROJECT_ID=

# Chave de API do projeto (Console -> Overview -> Integrations -> API keys).
# Precisa dos escopos: databases, collections, attributes, indexes, buckets,
# files, users. É usada SÓ por scripts no seu terminal — nunca chega ao
# navegador e nunca deve ser publicada.
APPWRITE_API_KEY=

# ------------------------------------------------- recursos do app (padrão) ---
# Criados por `npm run appwrite:setup`. Pode trocar os nomes, mas mantenha os
# mesmos valores aqui e no servidor.
APPWRITE_DATABASE_ID=sacadaweb_mapas
APPWRITE_FOLDERS_ID=folders
APPWRITE_MAPS_ID=maps
APPWRITE_VERSIONS_ID=versions
APPWRITE_MAPS_BUCKET_ID=maps

# --------------------------------------------------------------- servidor ----
# Porta do servidor que entrega a interface (o Caddy fica na frente).
PORT=3000

# Domínio público no Caddy. Sem domínio, use ":80" (só HTTP).
DOMAIN=:80
